# CUDA base image for optional GPU smoke tests and future GPU benchmarks.
# This image is separate from the CPU CI image so the main PR gate stays light.
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    g++ \
    make \
    libgomp1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["bash"]